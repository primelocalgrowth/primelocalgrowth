---
import Logo from './Logo.astro';
import { CTA, CONTACT } from '../config/site.mjs';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-pre">
    <div class="footer-cta-band">
      <div>
        <h3>See how visible your business really is.</h3>
      </div>
      <a class="btn btn-primary" href={CTA.auditHref}>{CTA.auditLabel}</a>
    </div>
  </div>
  <div class="footer-main">
    <div class="footer-inner">
      <div class="footer-brand">
        <Logo width={32} height={37} />
        <strong>Prime Local Growth</strong>
        <p>Veteran-owned Google Business Profile management for service businesses, done online.</p>
        <div class="footer-rating">
          <span class="footer-stars">★★★★★</span>
          <span>5.0 on Google</span>
        </div>
        <div class="footer-contact">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a><br>
          <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a> <span style="opacity:.7">call or text</span>
        </div>
      </div>
      <nav class="footer-col" aria-label="Services navigation">
        <div class="footer-col-head">Services</div>
        <a href="/services">All Services</a>
        <a href="/free-visibility-audit">Free Visibility Audit</a>
        <a href="/the-system">How It Works</a>
        <a href="/results">Results</a>
        <a href="/refer">Refer a Business</a>
        <a href="/about">About Adam</a>
        <a href="/contact">Contact</a>
      </nav>
      <nav class="footer-col" aria-label="Resources navigation">
        <div class="footer-col-head">Resources</div>
        <a href="/sample-audit">Sample Audit</a>
        <a href="/ai-visibility-scorecard">AI Visibility Scorecard</a>
        <a href="/gbp-scorecard">Profile Scorecard</a>
        <a href="/newsletter">Weekly tips</a>
        <a href="/service-area">Where we work</a>
      </nav>
      <nav class="footer-col" aria-label="Legal navigation">
        <div class="footer-col-head">Legal</div>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/accessibility">Accessibility</a>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="wrap footer-bottom-inner">
      <p>&copy; {year} Prime Local Growth &middot; Based in Cibolo, TX, serving clients online</p>
      <p>Veteran-Owned &middot; No Long-Term Contract &middot; Progress Tracked Monthly</p>
    </div>
  </div>
</footer>
