---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { CTA } from '../config/site.mjs';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/services". Absolute canonical is derived from it. */
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  /** Set false on pages that intentionally omit the shared chrome. */
  chrome?: boolean;
  /**
   * Body scripts, in order. Not every page loads the same set: the form pages
   * need site-form.js and the city pages deliberately skip exit-intent.js, so
   * this is per-page rather than hardcoded.
   */
  scripts?: string[];
  /** The fixed audit CTA that only /results and /the-system carry. */
  stickyAudit?: boolean;
}

const SITE = 'https://www.primelocalgrowth.com';
const DEFAULT_OG_IMAGE = `${SITE}/assets/gbp-results-og.jpg`;

const {
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  chrome = true,
  scripts = ['site-interactions'],
  stickyAudit = false,
} = Astro.props;

// exit-intent is the only deferred body script on the existing pages.
const DEFERRED = new Set(['exit-intent']);

const canonical = `${SITE}${path}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content={ogType}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={ogImage}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/site.css">
  <slot name="head" />
  <script is:inline src="/cookie-consent.js"></script>
  <script is:inline defer src="/site-analytics.js"></script>
  <script is:inline defer src="/vercel-insights.js"></script>
</head>
<body>
  {chrome && <Nav />}
  <main id="main">
    <slot />
  </main>
  <slot name="before-footer" />
  {chrome && <Footer />}
  {scripts.map((name) => (
    DEFERRED.has(name)
      ? <script is:inline defer src={`/${name}.js`}></script>
      : <script is:inline src={`/${name}.js`}></script>
  ))}
  {stickyAudit && (
    <div class="sticky-audit" aria-label="Get free audit">
      <a class="btn btn-primary" href={CTA.auditHref}>{CTA.auditLabel}</a>
    </div>
  )}
</body>
</html>
