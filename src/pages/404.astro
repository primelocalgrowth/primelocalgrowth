---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page Not Found | Prime Local Growth"
  description="The page you requested could not be found. Return to Prime Local Growth and find the right next step."
  path="/404"
  ogTitle="Page Not Found | Prime Local Growth"
  ogDescription="Find the right next step for your local visibility and growth."
>
  <section class="page-hero">
    <div class="wrap narrow">
      <p class="eyebrow">404 · Page not found</p>
      <h1>That page is no longer here.</h1>
      <p class="lead">The link may have moved. Start with the work, the services, or a plain-English visibility review.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/free-visibility-audit">Get the free visibility audit</a>
        <a class="btn btn-secondary" href="/results">See the work</a>
      </div>
    </div>
  </section>
</Base>
