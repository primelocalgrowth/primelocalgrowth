---
import Base from '../layouts/Base.astro';
import { renderPrices } from '../../shared/pricing.mjs';
import body from '../content-html/ai-visibility-scorecard.html?raw';
const headExtras = "<style>\n    .scorecard-wrap { max-width: 680px; margin: 0 auto; }\n    .progress-bar-outer { height: 6px; background: var(--line); border-radius: 999px; margin: 28px 0 36px; overflow: hidden; }\n    .progress-bar-inner { height: 100%; background: var(--blue); border-radius: 999px; transition: width 400ms ease; }\n    .question-block { display: none; animation: card-rise 320ms ease both; }\n    .question-block.active { display: block; }\n    .question-label { font-size: 13px; font-weight: 900; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 12px; }\n    .question-text { font-family: 'Montserrat', sans-serif; font-size: clamp(20px, 3vw, 28px); font-weight: 800; color: var(--ink); line-height: 1.2; margin: 0 0 10px; }\n    .question-sub { color: var(--muted); font-size: 15px; margin: 0 0 28px; }\n    .answer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }\n    .answer-btn { padding: 18px 20px; border: 2px solid var(--line); border-radius: 12px; background: #fff; font-size: 16px; font-weight: 800; color: var(--ink); cursor: pointer; text-align: left; transition: border-color 160ms, background 160ms, transform 140ms; }\n    .answer-btn:hover { border-color: var(--blue); background: #f0f9ff; transform: translateY(-2px); }\n    .answer-btn.selected { border-color: var(--blue); background: #E2EEE6; color: var(--blue-dark); }\n    .next-btn { display: none; margin-top: 8px; }\n    .next-btn.show { display: inline-flex; }\n    .results-block { display: none; animation: card-rise 400ms ease both; }\n    .results-block.show { display: block; }\n    .score-ring { width: 120px; height: 120px; border-radius: 50%; display: grid; place-items: center; margin: 0 auto 24px; position: relative; }\n    .score-ring svg { position: absolute; inset: 0; transform: rotate(-90deg); }\n    .score-ring-num { font-family: 'Montserrat', sans-serif; font-size: 32px; font-weight: 800; position: relative; z-index: 1; }\n    .score-label { text-align: center; font-family: 'Montserrat', sans-serif; font-size: 22px; font-weight: 800; margin-bottom: 8px; }\n    .score-summary { text-align: center; color: var(--muted); font-size: 16px; max-width: 480px; margin: 0 auto 32px; line-height: 1.6; }\n    .gap-list { display: grid; gap: 10px; margin: 24px 0; }\n    .gap-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; background: #fff; border: 1px solid var(--line); border-radius: 12px; }\n    .gap-icon { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 900; margin-top: 1px; }\n    .gap-icon.bad { background: #fee2e2; color: #b91c1c; }\n    .gap-icon.good { background: #dcfce7; color: #166534; }\n    .gap-text { font-size: 15px; font-weight: 700; color: var(--ink-2); line-height: 1.4; }\n    .stat-banner { background: linear-gradient(135deg,#14342B,#1E4A3D); color:#fff; border-radius:16px; padding:24px 28px; margin: 0 0 36px; text-align:center; border:1px solid rgba(255,159,28,0.3); }\n    .stat-banner strong { color:#FF9F1C; font-size:32px; font-family:'Montserrat',sans-serif; display:block; line-height:1; margin-bottom:6px; }\n    .stat-banner span { font-size:14px; color:#BFD2C7; }\n    .cta-capture { background: var(--ink); color: #fff; border-radius: 18px; padding: 36px; text-align: center; margin-top: 32px; }\n    .cta-capture h2 { font-size: 24px; margin-bottom: 10px; }\n    .cta-capture p { color: #BFD2C7; font-size: 15px; margin: 0 0 24px; }\n    .capture-form { display: grid; gap: 12px; max-width: 400px; margin: 0 auto; }\n    .capture-form input { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; border-radius: 10px; }\n    .capture-form input::placeholder { color: rgba(255,255,255,0.45); }\n    .capture-form input:focus { border-color: var(--blue-light); outline: none; }\n    .already-link { margin-top: 16px; font-size: 13px; color: #9DB5A7; }\n    .already-link a { color: var(--blue-light); }\n    @media (max-width: 560px) { .answer-grid { grid-template-columns: 1fr; } }\n    .scan-block { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 32px; margin-top: 36px; }\n    .scan-block h2 { font-family: 'Montserrat', sans-serif; font-size: 22px; font-weight: 800; margin: 0 0 10px; color: var(--ink); }\n    .scan-intro { color: var(--muted); font-size: 15px; line-height: 1.6; margin: 0 0 22px; }\n    .scan-form { display: grid; gap: 14px; }\n    .scan-form .field label { display: block; font-size: 13px; font-weight: 800; color: var(--ink-2); margin-bottom: 6px; }\n    .scan-form .field label .opt { font-weight: 500; color: var(--muted); }\n    .scan-form input[type=text], .scan-form input[name=businessName] { width: 100%; padding: 13px 14px; border: 1px solid var(--line); border-radius: 10px; font: inherit; font-size: 16px; color: var(--ink); background: #fff; }\n    .scan-form input[type=text]:focus, .scan-form input[name=businessName]:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px var(--focus); }\n    .scan-consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; line-height: 1.5; color: var(--muted); cursor: pointer; }\n    .scan-consent input { margin-top: 3px; flex-shrink: 0; }\n    .scan-result { margin-top: 18px; font-size: 15px; }\n    .scan-result.err { color: #b91c1c; font-weight: 700; }\n    .scan-result .scan-score { font-family: 'Montserrat', sans-serif; font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 8px; }\n    .scan-link-row { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }\n    .scan-link-row input { flex: 1 1 240px; padding: 11px 12px; border: 1px solid var(--line); border-radius: 10px; font: inherit; font-size: 14px; background: var(--soft); color: var(--ink); }\n    .scan-copy { padding: 11px 16px; border: 1px solid var(--line); border-radius: 10px; background: #fff; font-weight: 800; font-size: 14px; cursor: pointer; color: var(--ink); }\n    .scan-copy:hover { border-color: var(--blue); }\n  </style>";
---
<Base
  title="Are You Invisible to AI? | Prime Local Growth"
  description="When customers ask ChatGPT, Gemini, or Google's AI 'best [service] near me', does your business get named? Score your AI visibility in 60 seconds."
  path="/ai-visibility-scorecard"
  ogDescription="Only 1.2% of businesses get recommended by ChatGPT. Find out if you're one of them, in 60 seconds."
  ogImage="https://www.primelocalgrowth.com/assets/gbp-results-og.jpg"
  scripts={["exit-intent", "site-form", "site-interactions", "scorecard"]}
>
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={renderPrices(body)} />
</Base>
