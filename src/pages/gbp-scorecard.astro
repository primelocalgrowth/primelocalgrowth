---
import Base from '../layouts/Base.astro';
import { renderPrices } from '../../shared/pricing.mjs';
import body from '../content-html/gbp-scorecard.html?raw';
const headExtras = "<style>\n    .scorecard-wrap {\n      max-width: 680px;\n      margin: 0 auto;\n    }\n    .progress-bar-outer {\n      height: 6px;\n      background: var(--line);\n      border-radius: 999px;\n      margin: 28px 0 36px;\n      overflow: hidden;\n    }\n    .progress-bar-inner {\n      height: 100%;\n      background: var(--blue);\n      border-radius: 999px;\n      transition: width 400ms ease;\n    }\n    .question-block {\n      display: none;\n      animation: card-rise 320ms ease both;\n    }\n    .question-block.active { display: block; }\n    .question-label {\n      font-size: 13px;\n      font-weight: 900;\n      color: var(--muted);\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      margin-bottom: 12px;\n    }\n    .question-text {\n      font-family: 'Montserrat', sans-serif;\n      font-size: clamp(20px, 3vw, 28px);\n      font-weight: 800;\n      color: var(--ink);\n      line-height: 1.2;\n      margin: 0 0 10px;\n    }\n    .question-sub {\n      color: var(--muted);\n      font-size: 15px;\n      margin: 0 0 28px;\n    }\n    .answer-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 12px;\n      margin-bottom: 24px;\n    }\n    .answer-btn {\n      padding: 18px 20px;\n      border: 2px solid var(--line);\n      border-radius: 12px;\n      background: #fff;\n      font-size: 16px;\n      font-weight: 800;\n      color: var(--ink);\n      cursor: pointer;\n      text-align: left;\n      transition: border-color 160ms, background 160ms, transform 140ms;\n    }\n    .answer-btn:hover {\n      border-color: var(--blue);\n      background: #f0f9ff;\n      transform: translateY(-2px);\n    }\n    .answer-btn.selected {\n      border-color: var(--blue);\n      background: #E2EEE6;\n      color: var(--blue-dark);\n    }\n    .answer-btn.yes { }\n    .answer-btn.no { }\n    .next-btn {\n      display: none;\n      margin-top: 8px;\n    }\n    .next-btn.show { display: inline-flex; }\n\n    /* Results */\n    .results-block { display: none; animation: card-rise 400ms ease both; }\n    .results-block.show { display: block; }\n    .score-ring {\n      width: 120px;\n      height: 120px;\n      border-radius: 50%;\n      display: grid;\n      place-items: center;\n      margin: 0 auto 24px;\n      position: relative;\n    }\n    .score-ring svg {\n      position: absolute;\n      inset: 0;\n      transform: rotate(-90deg);\n    }\n    .score-ring-num {\n      font-family: 'Montserrat', sans-serif;\n      font-size: 32px;\n      font-weight: 800;\n      position: relative;\n      z-index: 1;\n    }\n    .score-label {\n      text-align: center;\n      font-family: 'Montserrat', sans-serif;\n      font-size: 22px;\n      font-weight: 800;\n      margin-bottom: 8px;\n    }\n    .score-summary {\n      text-align: center;\n      color: var(--muted);\n      font-size: 16px;\n      max-width: 480px;\n      margin: 0 auto 32px;\n      line-height: 1.6;\n    }\n    .gap-list {\n      display: grid;\n      gap: 10px;\n      margin: 24px 0;\n    }\n    .gap-item {\n      display: flex;\n      align-items: flex-start;\n      gap: 12px;\n      padding: 14px 16px;\n      background: #fff;\n      border: 1px solid var(--line);\n      border-radius: 12px;\n    }\n    .gap-icon {\n      flex-shrink: 0;\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      display: grid;\n      place-items: center;\n      font-size: 12px;\n      font-weight: 900;\n      margin-top: 1px;\n    }\n    .gap-icon.bad { background: #fee2e2; color: #b91c1c; }\n    .gap-icon.warn { background: #fef3c7; color: #92400e; }\n    .gap-icon.good { background: #dcfce7; color: #166534; }\n    .gap-text { font-size: 15px; font-weight: 700; color: var(--ink-2); line-height: 1.4; }\n    .cta-capture {\n      background: var(--ink);\n      color: #fff;\n      border-radius: 18px;\n      padding: 36px;\n      text-align: center;\n      margin-top: 32px;\n    }\n    .cta-capture h2 { font-size: 24px; margin-bottom: 10px; }\n    .cta-capture p { color: #BFD2C7; font-size: 15px; margin: 0 0 24px; }\n    .capture-form { display: grid; gap: 12px; max-width: 400px; margin: 0 auto; }\n    .capture-form input {\n      background: rgba(255,255,255,0.1);\n      border: 1px solid rgba(255,255,255,0.2);\n      color: #fff;\n      border-radius: 10px;\n    }\n    .capture-form input::placeholder { color: rgba(255,255,255,0.45); }\n    .capture-form input:focus { border-color: var(--blue-light); outline: none; }\n    .already-link {\n      margin-top: 16px;\n      font-size: 13px;\n      color: #9DB5A7;\n    }\n    .already-link a { color: var(--blue-light); }\n    @media (max-width: 560px) {\n      .answer-grid { grid-template-columns: 1fr; }\n    }\n  </style>";
---
<Base
  title="GBP Readiness Score | Prime Local Growth"
  description="Score your Google Business Profile in 60 seconds. Find out exactly where your local visibility is weak, and what to fix first."
  path="/gbp-scorecard"
  ogDescription="10 questions. 60 seconds. Find out why customers aren't calling you from Google."
  ogImage="https://www.primelocalgrowth.com/assets/gbp-results-og.jpg"
  scripts={["exit-intent", "site-form", "site-interactions", "scorecard"]}
>
  <Fragment slot="head" set:html={headExtras} />
  <Fragment set:html={renderPrices(body)} />
</Base>
