---
import Base from '../layouts/Base.astro';
import { renderPrices } from '../../shared/pricing.mjs';
import body from '../content-html/services.html?raw';
---
<Base
  title="Local Visibility Services | Prime Local Growth"
  description="Google Business Profile optimization, local SEO, review growth, reputation support, website conversion fixes, and local visibility audits for service businesses."
  path="/services"
  ogDescription="Focused services that help local businesses get found on Google, stay visible, and win more local customers."
  ogImage="https://www.primelocalgrowth.com/og-image.png"
  scripts={["site-interactions","exit-intent"]}
>
  <Fragment set:html={renderPrices(body)} />
</Base>
